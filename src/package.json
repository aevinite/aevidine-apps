{
  "name": "aevidine-desktop",
  "productName": "Aevidine",
  "version": "1.0.0",
  "private": true,
  "description": "Aevidine for Windows, Mac and Linux \u2014 a window around https://aevinite.shop (docs/APPS-EVERYWHERE.md, P3).",
  "author": "Aevinite <support@aevinite.com>",
  "homepage": "https://aevidine.aevinite.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:test": "AEVI_SITE=https://test.aevinite.shop electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.aevinite.aevidine.desktop",
    "productName": "Aevidine",
    "copyright": "\u00a9 Aevinite",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "site.json",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Aevidine sign-in",
        "schemes": [
          "aevidine"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "aevinite",
        "repo": "aevidine-apps",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "Aevidine-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Aevidine"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Aevidine-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "Aevinite.Aevidine",
      "publisher": "CN=B6EC2A4A-DF2A-45C2-A2A2-F41867206B5A",
      "publisherDisplayName": "Aevinite",
      "applicationId": "Aevidine",
      "displayName": "Aevidine",
      "backgroundColor": "#0D1017",
      "languages": [
        "en-US"
      ],
      "artifactName": "Aevidine-Store-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "Aevinite <support@aevinite.com>",
      "artifactName": "Aevidine-${version}-${arch}.${ext}"
    }
  }
}
